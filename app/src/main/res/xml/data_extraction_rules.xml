<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above.

     cloud-backup excludes everything: nothing about a user's schedule may be
     uploaded to Google's servers, which is what the privacy policy promises.

     device-transfer is intentionally absent. With no rules declared for it the
     platform transfers the app's data during a direct phone-to-phone setup, so
     a student changing handset keeps their notes. That copy never leaves the
     two devices involved. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
