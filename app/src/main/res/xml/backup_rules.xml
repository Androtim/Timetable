<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below: no cloud backup of anything. These devices have no
     device-to-device transfer to preserve, so everything is excluded. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
